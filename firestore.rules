rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if current user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Direct user documents and subcollections (profile, quizzes, stats)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy/artifact paths (artifacts/{appId}/users/{userId}/...)
    match /artifacts/{appId}/users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Unsubscribe records (write-only for client opt-outs, read by Admin SDK)
    match /unsubscribes/{recordId} {
      allow create, update: if true;
      allow read: if false;
    }
  }
}
